	measure 'Bad Seller Rate (%)' = ```
			
			VAR TotalSellers = COUNTROWS('marts seller_metrics')
			VAR BadSellers = 
			    CALCULATE(
			        COUNTROWS('marts seller_metrics'),
			        'marts seller_metrics'[average_review_score] <= 2
			    )
			RETURN
			    DIVIDE(BadSellers, TotalSellers, 0)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: ac9d4a21-c2b2-485c-861a-5848f6fa728a

	measure 'Top 10 Product Sales Dynamic' = ```
			
			VAR Ranking = 
			    RANKX(
			        ALLSELECTED('intermediate int_product_category_name_translation'[product_category_name_english]), 
			        [Total Sales], 
			        , 
			        DESC, 
			        Dense
			    )
			RETURN
			    IF(Ranking <= 10, [Total Sales], BLANK())
			```
		lineageTag: cab61594-5b7e-4adc-93f5-d9ca90ff09b5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

