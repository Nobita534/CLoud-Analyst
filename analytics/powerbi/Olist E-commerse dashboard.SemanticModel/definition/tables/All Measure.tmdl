	measure 'Customer Tooltip Context' =
			
			VAR StateName =
			    SELECTEDVALUE(
			        'marts dim_customer_snapshot_location'[customer_state],
			        "Multiple states"
			    )
			VAR SegmentName =
			    SELECTEDVALUE(
