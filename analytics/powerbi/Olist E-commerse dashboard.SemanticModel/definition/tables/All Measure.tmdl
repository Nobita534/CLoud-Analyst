	measure 'Revenue SPLY' =
			
			VAR PreviousStart =
			    EDATE(MIN('marts dim_date'[full_date]), -12)
			VAR PreviousEnd =
			    EDATE([YoY Period End], -12)
			RETURN
			    IF(
			        [YoY Period Valid],
			        CALCULATE(
			            [Total Revenue],
			            REMOVEFILTERS('marts dim_date'),
			            DATESBETWEEN(
			                'marts dim_date'[full_date],
			                PreviousStart,
			                PreviousEnd
			            )
			        )
			    )
		lineageTag: 11b18837-f5e2-4ceb-a56f-8b3be0c568a3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenue YoY %' =
			
			IF(
			    [YoY Period Valid],
			    DIVIDE(
			        [Revenue Comparable Period] - [Revenue SPLY],
			        [Revenue SPLY]
			    )
			)
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 0120eef6-220b-4cb8-aa28-1ab947dde9bc

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Total Orders LY' =
			
			VAR PreviousStart =
			    EDATE(MIN('marts dim_date'[full_date]), -12)
			VAR PreviousEnd =
			    EDATE([YoY Period End], -12)
			RETURN
			    IF(
			        [YoY Period Valid],
			        CALCULATE(
			            [Total Orders],
			            REMOVEFILTERS('marts dim_date'),
			            DATESBETWEEN(
