	measure 'Average Category Review Score' =
			
			VAR CategoryOrders =
			    CALCULATETABLE(
			        VALUES('marts fact_order_items'[order_id]),
			        KEEPFILTERS(
			            'marts dim_orders'[order_status] = "delivered"
			        )
			    )
			
			RETURN
			    AVERAGEX(
			        CategoryOrders,
			        VAR CurrentOrder =
			            'marts fact_order_items'[order_id]
			        RETURN
			            CALCULATE(
			                AVERAGE('marts fact_review'[review_score]),
			                KEEPFILTERS(
			                    TREATAS(
			                        { CurrentOrder },
			                        'marts fact_review'[order_id]
			                    )
			                )
			            )
			    )
		lineageTag: af549005-142b-45d9-b9e1-70077aaf38e7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Top 1 State by Product Sales' =
			
			VAR StateSales =
			    CALCULATETABLE(
			        ADDCOLUMNS(
			            VALUES('marts product_metrics'[customer_state]),
			            "@Sales", CALCULATE([Product Sales])
			        ),
			        REMOVEFILTERS('marts product_metrics'[customer_state])
			    )
			
			VAR TopState =
			    TOPN(
			        1,
			        FILTER(
			            StateSales,
			            NOT ISBLANK('marts product_metrics'[customer_state])
			                && [@Sales] > 0
			        ),
			        [@Sales], DESC,
			        'marts product_metrics'[customer_state], ASC
			    )
			
			RETURN
			    IF(
			        COUNTROWS(TopState) = 0,
			        "--",
			        CONCATENATEX(
			            TopState,
			            'marts product_metrics'[customer_state]
			                & " | "
			                & FORMAT([@Sales], "R$ #,##0.00"),
			            ""
			        )
			    )
		lineageTag: 8d018076-ca92-4ef6-94f0-d0df1b2b4aaa

