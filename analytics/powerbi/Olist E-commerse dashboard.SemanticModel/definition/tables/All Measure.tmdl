	measure 'Data Start Date' =
			
			VAR DateKey =
			    CALCULATE(
			        MIN('marts revenue_metrics'[order_purchase_date_key]),
			        REMOVEFILTERS()
			    )
			RETURN
			    IF(
			        NOT ISBLANK(DateKey),
			        DATE(
			            INT(DateKey / 10000),
			            INT(MOD(DateKey, 10000) / 100),
			            MOD(DateKey, 100)
			        )
			    )
		formatString: General Date
		lineageTag: 4cefe0a8-d42f-46ad-baae-01e67e32622b

	measure 'Data End Date' =
			
			VAR DateKey =
			    CALCULATE(
			        MAX('marts revenue_metrics'[order_purchase_date_key]),
			        REMOVEFILTERS()
			    )
			RETURN
			    IF(
			        NOT ISBLANK(DateKey),
			        DATE(
			            INT(DateKey / 10000),
			            INT(MOD(DateKey, 10000) / 100),
			            MOD(DateKey, 100)
			        )
			    )
		formatString: General Date
