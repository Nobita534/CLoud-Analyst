	measure 'YoY Period End' =
			
			VAR SelectedStart =
			    MIN('marts dim_date'[full_date])
			VAR SelectedEnd =
			    MAX('marts dim_date'[full_date])
			VAR Cutoff = [Data End Date]
			RETURN
			    IF(
			        NOT ISBLANK(Cutoff)
			            && SelectedStart <= Cutoff,
			        MIN(SelectedEnd, Cutoff)
			    )
		formatString: General Date
		lineageTag: b83c78ba-d824-4c15-930d-64a5156f7eae

	measure 'YoY Period Valid' =
			
			VAR SelectedStart =
			    MIN('marts dim_date'[full_date])
			VAR SelectedEnd =
			    MAX('marts dim_date'[full_date])
			VAR PeriodEnd = [YoY Period End]
			
			VAR OneYearSelected =
			    HASONEVALUE('marts dim_date'[year])
			
			VAR ContinuousPeriod =
			    COUNTROWS(VALUES('marts dim_date'[full_date]))
			        = DATEDIFF(SelectedStart, SelectedEnd, DAY) + 1
			
			VAR PreviousStart =
			    EDATE(SelectedStart, -12)
			
			RETURN
			    OneYearSelected
			        && ContinuousPeriod
			        && NOT ISBLANK(PeriodEnd)
			        && NOT ISBLANK([Data Start Date])
			        && PreviousStart >= [Data Start Date]
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: c45af5b3-920b-4d23-84a1-40ff3fa40613

