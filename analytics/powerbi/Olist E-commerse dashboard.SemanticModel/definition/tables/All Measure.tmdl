	measure 'YoY Comparison Label' =
			
			VAR StartDate = MIN('marts dim_date'[full_date])
			VAR EndDate = [YoY Period End]
			RETURN
			    IF(
			        [YoY Period Valid],
			        FORMAT(StartDate, "dd/MM/yyyy")
			            & " – " & FORMAT(EndDate, "dd/MM/yyyy")
			            & " vs "
			            & FORMAT(EDATE(StartDate, -12), "dd/MM/yyyy")
			            & " – " & FORMAT(EDATE(EndDate, -12), "dd/MM/yyyy"),
			        "YoY unavailable for this period"
