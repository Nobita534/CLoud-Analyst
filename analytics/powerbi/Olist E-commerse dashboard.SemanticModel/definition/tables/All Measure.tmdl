	measure 'Latest Purchase Date' =
			
			VAR SnapshotKey =
			    SELECTEDVALUE(
			        'marts customer_metrics'[analysis_date_key]
			    )
			VAR MinRecency =
			    MIN('marts customer_metrics'[recency])
			RETURN
			    IF(
			        NOT ISBLANK(SnapshotKey)
			            && NOT ISBLANK(MinRecency),
			        VAR SnapshotDate =
			            DATE(
			                INT(SnapshotKey / 10000),
			                INT(MOD(SnapshotKey, 10000) / 100),
			                MOD(SnapshotKey, 100)
			            )
			        RETURN
			            SnapshotDate - MinRecency
			    )
		formatString: General Date
		lineageTag: 3ef65fcc-3bb1-4675-b902-967e0ff59b17

